# third-party reference material (cloned repos, mirrored extension builds)
reference/*
!reference/*.trex

node_modules/
dist/
*.log
.env
.env.*
!.env.example
.claude/settings.local.json

# regenerate with: python -I scripts/make_synthetic.py
data/synthetic/large_*.csv

# Tableau temp/lock and backup files
~*.twbr
~*.twb
*.twbr

# working copies of workbooks at the top level (examples/ holds the shared test workbook)
/*.twb
/*.twbx

# temporary mock-ups (rendered by scripts/showcase/_mockup-*.test.ts, served by the dev server)
vizzes/*/app/mockups/
scripts/showcase/_mockup*
