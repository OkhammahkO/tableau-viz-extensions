{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@kit/*": [
        "./kit/*"
      ]
    }
  },
  "include": [
    "kit",
    "vizzes",
    "vitest.config.ts"
  ]
}
